# Copy to .env (or set these in your hosting platform's environment settings).

# Port the server listens on. Hosting platforms usually set this for you.
PORT=3000

# Directory for the two SQLite database files (study.db and consent.db).
# On a hosting platform, point this at a persistent disk/volume.
DATA_DIR=./data

# Long random secret required to reach the /admin page and export endpoints.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=change-me

# Optional separate secret for the consent-log export (PI only). Defaults to ADMIN_TOKEN.
# CONSENT_TOKEN=

# Condition assignment: "simple" (independent 25% draw, protocol default)
# or "block" (permuted blocks of four, keeps cell sizes equal as N grows).
RANDOMISATION=simple

# Precision of the timestamp written to the consent log: "exact" | "minute" | "hour".
# Coarser values reduce the chance of matching a consent record to a session by time.
CONSENT_TIMESTAMP_PRECISION=exact

# Link to the separate Google Form for early access to findings (shown after submit).
# Leave empty to hide the link.
FOLLOWUP_FORM_URL=

# Set to "true" only if the IRB requires an immediate debriefing: the closing screen then
# shows the full explanation from Appendix C.2 instead of the delayed-explanation text in C.1.
IMMEDIATE_DEBRIEF=false

# Set to "true" to stop accepting new sessions (shows a "study closed" notice).
STUDY_CLOSED=false
